<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="warehouse_layout_area_view_list" model="ir.ui.view">
        <field name="name">warehouse.layout.area.list</field>
        <field name="model">warehouse.layout.area</field>
        <field name="arch" type="xml">
            <list string="Layout Areas" editable="bottom">
                <field name="name"/>
                <field name="kind"/>
                <field name="warehouse_id" groups="stock.group_stock_multi_warehouses"/>
                <field name="x"/>
                <field name="y"/>
                <field name="width"/>
                <field name="depth"/>
            </list>
        </field>
    </record>

    <record id="action_warehouse_layout_area" model="ir.actions.act_window">
        <field name="name">Layout Areas</field>
        <field name="res_model">warehouse.layout.area</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a floor area or a dock door</p>
            <p>Areas such as Receiving or Packing, and dock doors, are drawn on the floor plan. They hold no stock.</p>
        </field>
    </record>

    <record id="view_warehouse_form_wh3d" model="ir.ui.view">
        <field name="name">stock.warehouse.form.wh3d</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <!-- Before the notebook: its tabs are hidden unless multi-step routes or several warehouses are on. -->
            <xpath expr="//notebook" position="before">
                <group string="3D Layout" name="wh3d_layout">
                    <group>
                        <field name="wh3d_length"/>
                        <field name="wh3d_width"/>
                        <field name="wh3d_height"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
