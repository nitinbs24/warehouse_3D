<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wh3d_putaway_explain_form" model="ir.ui.view">
        <field name="name">wh3d.putaway.explain.form</field>
        <field name="model">wh3d.putaway.explain</field>
        <field name="arch" type="xml">
            <form string="Why this slot?" create="0" edit="0">
                <field name="summary" class="text-muted"/>
                <field name="slot_ids" nolabel="1">
                    <list create="0" delete="0" edit="0">
                        <field name="slot_id"/>
                        <field name="score"/>
                        <field name="distance"/>
                        <field name="level"/>
                        <field name="reasons"/>
                        <button name="action_choose" type="object" string="Use this slot" class="btn-primary"/>
                    </list>
                </field>
                <field name="excluded" invisible="not excluded" readonly="1"/>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- The button sits on the receipt's detailed operations (Moves button and the per-line dialog). -->
    <record id="view_stock_move_line_detailed_operation_tree_wh3d" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.wh3d</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <field name="quantity" position="before">
                <button name="action_wh3d_explain_putaway" type="object" icon="fa-question-circle"
                        title="Why this slot?" string="Why this slot?"
                        invisible="not id or state in ('done', 'cancel') or picking_code != 'incoming'"/>
            </field>
        </field>
    </record>
</odoo>
