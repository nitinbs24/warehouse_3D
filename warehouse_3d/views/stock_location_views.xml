<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_location_view_form_wh3d" model="ir.ui.view">
        <field name="name">stock.location.form.wh3d</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_location_header')]" position="before">
                <div class="alert alert-info" role="status" invisible="not wh3d_rack_row_id">
                    Managed by rack row <field name="wh3d_rack_row_id" class="fw-bold" readonly="1"/>:
                    to rename or move this location, change the rack row instead.
                </div>
            </xpath>
            <field name="name" position="attributes">
                <attribute name="readonly">wh3d_rack_row_id</attribute>
            </field>
            <field name="location_id" position="attributes">
                <attribute name="readonly">wh3d_rack_row_id</attribute>
            </field>
            <field name="usage" position="attributes">
                <attribute name="readonly">wh3d_rack_row_id</attribute>
            </field>
        </field>
    </record>
</odoo>
