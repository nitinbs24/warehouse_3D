<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="warehouse_3d.LayoutEditor">
        <t t-set="rowProblems" t-value="problems"/>
        <t t-set="areaIssues" t-value="areaProblemMap"/>
        <div class="o_wh3d_editor" t-on-keydown="onKeydown" t-att-data-dirty="dirty ? '1' : '0'">
            <div class="o_wh3d_editor_main">
                <svg t-ref="plan" class="o_wh3d_plan" role="group" aria-label="Floor plan"
                     t-on-wheel="onWheel" t-on-pointerdown="onPointerDown"
                     t-on-pointermove="onPointerMove" t-on-pointerup="onPointerUp"
                     t-on-dragover="onPlanDragOver" t-on-drop="onPlanDrop">
                    <!-- Everything inside is in metres; this one transform does all zooming and panning. -->
                    <g t-att-transform="transform">
                        <rect class="o_wh3d_floor" x="0" y="0"
                              t-att-width="layout.building.length" t-att-height="layout.building.width"/>
                        <g class="o_wh3d_grid">
                            <line t-foreach="grid" t-as="line" t-key="line_index"
                                  t-att-x1="line.x1" t-att-y1="line.y1" t-att-x2="line.x2" t-att-y2="line.y2"
                                  t-att-class="line.major ? 'o_major' : ''" vector-effect="non-scaling-stroke"/>
                        </g>
                        <g t-foreach="docks" t-as="dock" t-key="dock.id" class="o_wh3d_dock">
                            <t t-set="r" t-value="areaRect(dock)"/>
                            <rect t-att-x="r.x" t-att-y="r.y" t-att-width="r.w" t-att-height="r.h"
                                  vector-effect="non-scaling-stroke"/>
                        </g>
                        <g t-foreach="state.areas" t-as="area" t-key="area.id"
                           class="o_wh3d_area"
                           t-att-class="{ o_selected: state.selectedAreaId === area.id, o_invalid: areaIssues[area.id], o_new: area.id &lt; 0 }"
                           t-att-data-name="area.name" tabindex="0" role="button"
                           t-att-aria-label="'Area ' + area.name + (areaIssues[area.id] ? ': ' + areaIssues[area.id] : '')"
                           t-att-aria-pressed="state.selectedAreaId === area.id ? 'true' : 'false'"
                           t-on-pointerdown="(ev) => this.onAreaPointerDown(ev, area)"
                           t-on-click="() => this.selectArea(area)" t-on-focus="() => this.selectArea(area)"
                           t-on-keydown="(ev) => this.onAreaKeydown(ev, area)">
                            <t t-set="r" t-value="areaRect(area)"/>
                            <rect t-att-x="r.x" t-att-y="r.y" t-att-width="r.w" t-att-height="r.h"
                                  t-att-fill="area.color" vector-effect="non-scaling-stroke"/>
                            <text t-att-x="r.x + r.w / 2" t-att-y="r.y + r.h / 2"
                                  text-anchor="middle" dominant-baseline="middle" t-esc="area.name"/>
                        </g>
                        <g t-foreach="state.rows" t-as="row" t-key="row.id"
                           class="o_wh3d_row"
                           t-att-class="{ o_selected: state.selectedId === row.id, o_shelf: row.kind === 'shelf', o_invalid: rowProblems[row.id], o_new: row.id &lt; 0 }"
                           t-att-data-code="row.code" tabindex="0" role="button"
                           t-att-aria-label="'Rack row ' + row.code + (rowProblems[row.id] ? ': ' + rowProblems[row.id] : '')"
                           t-att-aria-pressed="state.selectedId === row.id ? 'true' : 'false'"
                           t-on-pointerdown="(ev) => this.onRowPointerDown(ev, row)"
                           t-on-click="() => this.selectRow(row)" t-on-focus="() => this.selectRow(row)"
                           t-on-keydown="(ev) => this.onRowKeydown(ev, row)">
                            <t t-set="r" t-value="rowRect(row)"/>
                            <rect t-att-x="r.x" t-att-y="r.y" t-att-width="r.w" t-att-height="r.h"
                                  vector-effect="non-scaling-stroke"/>
                            <!-- Alternate above / below so back-to-back neighbours' codes don't collide. -->
                            <text t-att-x="r.x + r.w / 2" t-att-y="row_index % 2 ? r.y + r.h + 0.9 : r.y - 0.35"
                                  text-anchor="middle" t-esc="row.code"/>
                        </g>
                        <!-- Outside the area's own group, so grabbing a handle doesn't also move the area. -->
                        <t t-if="selectedArea">
                            <rect t-foreach="handles" t-as="h" t-key="h.edge" class="o_wh3d_handle"
                                  t-att-class="'o_h_' + h.edge" t-att-data-edge="h.edge"
                                  t-att-x="h.x - handleSize / 2" t-att-y="h.y - handleSize / 2"
                                  t-att-width="handleSize" t-att-height="handleSize" vector-effect="non-scaling-stroke"
                                  t-on-pointerdown="(ev) => this.onHandlePointerDown(ev, h.edge)"/>
                        </t>
                    </g>
                </svg>
                <div class="o_wh3d_editor_toolbar">
                    <button type="button" class="btn btn-light btn-sm" name="add_pallet" t-on-click="() => this.addRow('pallet')">
                        <i class="fa fa-plus" aria-hidden="true"/> Pallet row
                    </button>
                    <button type="button" class="btn btn-light btn-sm" name="add_shelf" t-on-click="() => this.addRow('shelf')">
                        <i class="fa fa-plus" aria-hidden="true"/> Shelf row
                    </button>
                    <button type="button" class="btn btn-light btn-sm" name="fit" t-on-click="onFitClick">Fit to screen</button>
                </div>
                <p class="o_wh3d_hint">Scroll to zoom · drag the floor to pan · drag a row or area to move it (0.1 m steps) · drag an area's handles to resize it · drag an area type from the right onto the plan · arrow keys nudge · Esc clears</p>
            </div>

            <aside class="o_wh3d_editor_panel">
                <section class="o_wh3d_card o_wh3d_savebar" t-att-class="{ o_dirty: dirty }">
                    <p class="o_wh3d_note" t-if="!dirty">All changes saved.</p>
                    <p class="o_wh3d_note" t-else="">Unsaved changes. Nothing is stored until you save.</p>
                    <ul t-if="problemList.length" class="o_wh3d_problems" role="alert">
                        <li t-foreach="problemList" t-as="problem" t-key="problem_index" t-esc="problem"/>
                    </ul>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary btn-sm" name="save"
                                t-att-disabled="!dirty or problemList.length or state.saving" t-on-click="save">Save</button>
                        <button type="button" class="btn btn-secondary btn-sm" name="discard"
                                t-att-disabled="!dirty or state.saving" t-on-click="discard">Discard</button>
                    </div>
                </section>

                <section class="o_wh3d_card o_wh3d_palette">
                    <p class="o_wh3d_label">Add area</p>
                    <div class="o_wh3d_palette_items">
                        <button t-foreach="areaTypes" t-as="type" t-key="type.key" type="button"
                                class="btn btn-light btn-sm o_wh3d_palette_item" t-att-name="'add_area_' + type.key"
                                draggable="true" t-on-dragstart="(ev) => this.onPaletteDragStart(ev, type)"
                                t-on-click="() => this.addArea(type)">
                            <span class="o_wh3d_swatch" t-att-style="'background:' + type.color"/>
                            <t t-esc="type.label"/>
                        </button>
                    </div>
                    <p class="o_wh3d_note">Drag onto the plan, or click to add in the middle. Areas are drawings only: no stock or locations.</p>
                </section>

                <section class="o_wh3d_card" t-if="selectedArea" name="area_card">
                    <t t-set="area" t-value="selectedArea"/>
                    <p class="o_wh3d_label">Area</p>
                    <p class="o_wh3d_code" t-esc="area.name"/>
                    <p t-if="areaIssues[area.id]" class="o_wh3d_err" t-esc="areaIssues[area.id]"/>
                    <div class="o_wh3d_fields">
                        <label for="o_wh3d_a_name">Name</label>
                        <input id="o_wh3d_a_name" name="area_name" class="form-control form-control-sm" t-att-value="area.name"
                               t-on-change="(ev) => this.onAreaField('name', ev)"/>
                        <label for="o_wh3d_a_color">Colour</label>
                        <input id="o_wh3d_a_color" name="area_color" type="color" class="form-control form-control-sm form-control-color"
                               t-att-value="area.color" t-on-change="(ev) => this.onAreaField('color', ev)"/>
                        <t t-foreach="[['x', 'X (m)'], ['y', 'Y (m)'], ['width', 'Width (m)'], ['depth', 'Depth (m)']]" t-as="f" t-key="f[0]">
                            <label t-att-for="'o_wh3d_a_' + f[0]" t-esc="f[1]"/>
                            <input t-att-id="'o_wh3d_a_' + f[0]" t-att-name="'area_' + f[0]" type="number" min="0" step="0.1"
                                   class="form-control form-control-sm" t-att-value="area[f[0]]"
                                   t-on-change="(ev) => this.onAreaField(f[0], ev)"/>
                        </t>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm" name="delete_area" t-on-click="deleteArea">Delete</button>
                </section>

                <section class="o_wh3d_card">
                    <p class="o_wh3d_label">Rack row</p>
                    <t t-if="selectedRow">
                        <t t-set="row" t-value="selectedRow"/>
                        <p class="o_wh3d_code" t-esc="row.code"/>
                        <p t-if="rowProblems[row.id]" class="o_wh3d_err" t-esc="rowProblems[row.id]"/>
                        <div class="o_wh3d_fields">
                            <label for="o_wh3d_f_code">Code</label>
                            <input id="o_wh3d_f_code" name="code" class="form-control form-control-sm" t-att-value="row.code"
                                   t-on-change="(ev) => this.onFieldInput('code', ev)"/>
                            <label for="o_wh3d_f_kind">Kind</label>
                            <select id="o_wh3d_f_kind" name="kind" class="form-select form-select-sm"
                                    t-on-change="(ev) => this.onFieldInput('kind', ev)">
                                <option value="pallet" t-att-selected="row.kind === 'pallet'">Pallet rack</option>
                                <option value="shelf" t-att-selected="row.kind === 'shelf'">Shelving</option>
                            </select>
                            <t t-foreach="[['x', 'X (m)', 0.1], ['y', 'Y (m)', 0.1], ['bays', 'Bays', 1], ['bay_width', 'Bay width (m)', 0.1], ['depth', 'Depth (m)', 0.1], ['levels', 'Levels', 1], ['level_height', 'Level height (m)', 0.1], ['slots_per_level', 'Slots per level', 1]]"
                               t-as="f" t-key="f[0]">
                                <label t-att-for="'o_wh3d_f_' + f[0]" t-esc="f[1]"/>
                                <input t-att-id="'o_wh3d_f_' + f[0]" t-att-name="f[0]" type="number" min="0" t-att-step="f[2]"
                                       class="form-control form-control-sm" t-att-value="row[f[0]]"
                                       t-att-disabled="f[0] === 'slots_per_level' and row.kind === 'shelf'"
                                       t-on-change="(ev) => this.onFieldInput(f[0], ev)"/>
                            </t>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" class="btn btn-secondary btn-sm" name="view_in_3d"
                                    t-att-disabled="row.id &lt; 0 or dirty" t-on-click="viewIn3d"
                                    t-att-title="dirty ? 'Save first' : ''">View in 3D</button>
                            <button type="button" class="btn btn-secondary btn-sm" name="open_form"
                                    t-att-disabled="row.id &lt; 0" t-on-click="openRowForm">Open record</button>
                            <button type="button" class="btn btn-outline-danger btn-sm" name="delete" t-on-click="deleteRow">Delete</button>
                        </div>
                    </t>
                    <p t-else="" class="o_wh3d_note">Click a rack row on the plan, or Tab to one. Add rows with the buttons above the plan.</p>
                </section>
                <section class="o_wh3d_card">
                    <p class="o_wh3d_label">Floor</p>
                    <p class="o_wh3d_note">
                        Building <t t-esc="layout.building.length"/> × <t t-esc="layout.building.width"/> m ·
                        <t t-esc="state.rows.length"/> rack rows · <t t-esc="state.areas.length"/> areas · <t t-esc="docks.length"/> docks
                    </p>
                </section>
            </aside>
        </div>
    </t>
</templates>
